@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-4">
    <h2>Unit Converter</h2>

    <form method="get" action="/Conversions">

        <div class="mb-3">
            <label for="ConversionType" class="form-label">Select Conversion Type:</label>
            <select id="ConversionType" name="Conversion.ConversionType" class="form-select">
                @foreach (var conversion in ConversionTypes.SupportedTypes)
                {
                    <option value=@(conversion.Key)>@conversion.Value</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="input" class="form-label">Value to Convert:</label>
            <input id="input" name="Conversion.Input" type="text" class="form-control" placeholder="e.g. 10" />
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
    </form>
</div>
